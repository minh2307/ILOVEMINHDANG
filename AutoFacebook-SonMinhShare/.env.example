# ============================================================
# .env.example — Cấu hình Module Thu Thập Tiêu Đề Bài Viết
# ============================================================
# Sao chép file này thành .env và điền giá trị thực.
# KHÔNG commit file .env lên git.

# ---- Biến cũ (KHÔNG thay đổi) ----
MODE=JOIN_BY_LIST
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_DOMAIN="y tế"
TASK4JOIN_CSV=data/task4join.csv
DEFAULT_GROUPS_CSV=data/selected_recruitment_groups.csv
DEFAULT_CONTENT_TXT=data/post_content.txt
DEFAULT_IMAGE_PATH=data/post1.jpeg
DEDUP_API_BASE=https://upload.cdha.ai/api/autopost.php
DEDUP_API_KEY=chuoi-bi-mat-dai-ngu-nhien
FB_POSTER_PROFILE="~/.cache/auto-join-ai/chrome-profile"
FB_POSTER_PROFILE_SECONDARY=1
HEADLESS=0

# ============================================================
# ---- Biến MỚI cho module Crawler (tiền tố FACEBOOK_) ----
# ============================================================

# --- Meta Graph API (phương án ưu tiên) ---
# Để lấy Page ID: https://www.facebook.com/robolearnai/about
# hoặc dùng: https://graph.facebook.com/robolearnai?access_token=<token>
FACEBOOK_PAGE_ID=

# Access Token của Page hoặc User có quyền đọc Page
# Cách lấy: https://developers.facebook.com/tools/explorer/
# Quyền cần có: pages_read_engagement, pages_show_list
# KHÔNG để token thật vào file này — dùng .env thực của bạn
FACEBOOK_ACCESS_TOKEN=

# Phiên bản Graph API (mặc định v21.0)
FACEBOOK_GRAPH_API_VERSION=v21.0

# --- Nguồn Page cần crawl ---
FACEBOOK_SOURCE_PAGE_URL=https://www.facebook.com/robolearnai

# Số bài tối đa mỗi lần chạy (mặc định 100)
FACEBOOK_MAX_POSTS=100

# Lấy bài từ ngày nào (ISO 8601, bỏ trống = không giới hạn)
FACEBOOK_CRAWL_SINCE=

# Lấy bài đến ngày nào (ISO 8601, bỏ trống = không giới hạn)
FACEBOOK_CRAWL_UNTIL=

# --- Browser automation (phương án dự phòng) ---
# Chạy ẩn trình duyệt khi crawl (khác với HEADLESS của chức năng cũ)
FACEBOOK_HEADLESS=true

# Số lần cuộn trang tối đa
FACEBOOK_SCROLL_LIMIT=50

# Delay giữa mỗi lần cuộn (giây)
FACEBOOK_SCROLL_DELAY_SECONDS=2

# Delay giữa mỗi request API (giây)
FACEBOOK_REQUEST_DELAY_SECONDS=2

# --- Output ---
OUTPUT_DIRECTORY=output
OUTPUT_CSV=output/robolearnai_titles.csv
OUTPUT_JSON=output/robolearnai_posts.json
OUTPUT_SUMMARY=output/robolearnai_crawl_summary.json
