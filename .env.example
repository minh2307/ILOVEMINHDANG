# Copy to .env and adjust locally. Never commit .env.
# All values shown here are safe examples — no real credentials.

# ============================================================
# Chrome browser settings
# ============================================================
APP_ENV=development
CHROME_PROFILE_DIR=runtime/chrome_profiles/cdha_automation
CHROME_CHANNEL=chrome
CHROME_EXECUTABLE_FALLBACK=/usr/bin/google-chrome
HEADLESS=false
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=1000
FACEBOOK_CDP_HOST=127.0.0.1
FACEBOOK_CDP_PORT=9222
FACEBOOK_BROWSER_LOCK_PATH=runtime/locks/facebook_browser.lock
FACEBOOK_BROWSER_PID_PATH=runtime/pids/facebook_chrome.pid
FACEBOOK_STARTUP_TIMEOUT_SECONDS=30
BROWSER_LOCK_TIMEOUT_SECONDS=120
BROWSER_LOCK_HEARTBEAT_SECONDS=15
BROWSER_LOCK_WAIT_TIMEOUT_SECONDS=180
BROWSER_LOCK_RETRY_INTERVAL_SECONDS=5
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_STAGE_TIMEOUT_SECONDS=1200
JOB_LEASE_SECONDS=240
JOB_HEARTBEAT_SECONDS=30
FACEBOOK_MAX_START_ATTEMPTS=2
FACEBOOK_DIAGNOSTICS_PATH=runtime/diagnostics
FACEBOOK_DOWNLOAD_PATH=runtime/downloads/facebook
FACEBOOK_COOKIE_FILE=runtime/auth/facebook_cookies.txt
FACEBOOK_COOKIE_REQUIRED=false

# ============================================================
# Facebook publishing settings
# ============================================================
FACEBOOK_TARGET_URL=
FACEBOOK_TARGET_TYPE=page
FACEBOOK_POST_LANGUAGE=vi
FACEBOOK_POST_HASHTAGS=#CDHA,#SieuAm,#ChanDoanHinhAnh,#MedicalAI,#HoiChan
FACEBOOK_FINAL_CONFIRMATION=false
AUTO_APPROVE_REVIEW=true
FACEBOOK_COMMENT_ENABLED=true
FACEBOOK_PUBLISH_TIMEOUT_SECONDS=180
FACEBOOK_UPLOAD_TIMEOUT_SECONDS=180
FACEBOOK_POST_DISCOVERY_TIMEOUT_SECONDS=120
FACEBOOK_MAX_IMAGE_COUNT=10
FACEBOOK_MAX_IMAGE_SIZE_MB=20
FACEBOOK_ALLOWED_IMAGE_EXTENSIONS=.png,.jpg,.jpeg,.webp
FACEBOOK_STATE_DETECTION_TIMEOUT_SECONDS=15
FACEBOOK_SELECTOR_PROBE_TIMEOUT_MS=1000
FACEBOOK_NAVIGATION_TIMEOUT_MS=45000
FACEBOOK_MAX_RETRIES=3
FACEBOOK_SAVE_DEBUG_ARTIFACTS=true
FACEBOOK_MANUAL_AUTH_TIMEOUT_SECONDS=900
PREFLIGHT_OLLAMA_TIMEOUT_SECONDS=30
PREFLIGHT_BROWSER_START_TIMEOUT_SECONDS=45
PREFLIGHT_FACEBOOK_TIMEOUT_SECONDS=30
PREFLIGHT_CDHA_TIMEOUT_SECONDS=30
PREFLIGHT_SELECTOR_TIMEOUT_SECONDS=5
PREFLIGHT_REPORT_DIR=runtime/diagnostics/preflight

# ============================================================
# Service URLs
# ============================================================
GEMINI_URL=https://gemini.google.com/app
CDHA_URL=https://cdha.ai/dash?modality=us_video&country=VN

# ============================================================
# Timeouts and polling (seconds)
# ============================================================
# These values are intentionally independent. JOB_LEASE_SECONDS must remain
# longer than JOB_HEARTBEAT_SECONDS.
BROWSER_ACTION_TIMEOUT_SECONDS=60
BROWSER_NAVIGATION_TIMEOUT_SECONDS=60
CDHA_UPLOAD_TIMEOUT_SECONDS=180
CDHA_RESULT_TIMEOUT_SECONDS=120
PAGE_TIMEOUT_SECONDS=60
UPLOAD_TIMEOUT_SECONDS=180
CDHA_ANALYSIS_TIMEOUT_SECONDS=900
CDHA_POLL_INTERVAL_SECONDS=3
CDHA_RESULT_STABILITY_SECONDS=5

# ============================================================
# Gemini / Clinical Factors limits (Legacy / Fallback)
# ============================================================
MAX_GEMINI_COMMENT_COUNT=100
MAX_GEMINI_COMMENT_CHARACTERS=15000
MAX_GEMINI_PROMPT_CHARACTERS=30000
MAX_CLINICAL_FACTORS_CHARACTERS=5000
CLINICAL_FACTORS_COMMENT_MAX_CHARS=600

# ============================================================
# Local AI Engine (Ollama)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
# Example models: llama3, qwen2.5, minicpm-v, llava
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_RETRIES=2
OLLAMA_PROMPT_VERSION=ollama-clinical-v1
OLLAMA_PROMPT_MAX_CHARS=30000
OLLAMA_COMMENT_TOTAL_MAX_CHARS=15000
SAVE_RAW_OLLAMA_RESPONSE=false

# ============================================================
# Frame Extraction (For Multimodal Vision Models)
# ============================================================
FRAME_EXTRACTION_ENABLED=true
FRAME_EXTRACTION_INTERVAL_SECONDS=2
FRAME_EXTRACTION_MAX_FRAMES=12
FRAME_EXTRACTION_WIDTH=1024
FRAME_JPEG_QUALITY=85
FRAME_SIMILARITY_THRESHOLD=5.0

# ============================================================
# Storage and diagnostics
# ============================================================
DATABASE_PATH=data/jobs.sqlite3
JOB_DATA_DIR=data/jobs
LOG_DIR=logs
SCREENSHOT_DIR=screenshots
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ============================================================
# DownloadReel configuration
# ============================================================
DOWNLOADREEL_DIR=app/infrastructure/legacy/dowloadReelFB
DOWNLOADREEL_ENABLE_INTERACTIONS=false
ENABLE_REEL_LIKE=false
ENABLE_COMMENT_LIKE=false
DOWNLOADREEL_CLEANUP_ACTIVE_ASSETS=false

# ============================================================
# Phase 5 retry limits
# ============================================================
MAX_DOWNLOAD_RETRIES=2
MAX_GEMINI_RETRIES=2
MAX_CDHA_RETRIES=2
MAX_FACEBOOK_PREPARE_RETRIES=2
MAX_PERMALINK_RETRIES=3
MAX_COMMENT_RETRIES=2
RETRY_INITIAL_DELAY_SECONDS=0.5
RETRY_MULTIPLIER=2.0
RETRY_MAX_DELAY_SECONDS=8.0
RETRY_JITTER_SECONDS=0.25

# Sensitive diagnostics are opt-in and disabled by default.
SAVE_DIAGNOSTIC_HTML=false
SAVE_RAW_GEMINI_PROMPT=false
SAVE_RAW_GEMINI_RESPONSE=false
DIAGNOSTIC_DIRECTORY=data/diagnostics

# ============================================================
# Phase 5/6 test mode (safe first-run controls)
# ============================================================
TEST_MODE=false
# Required when TEST_MODE=true
FACEBOOK_TEST_TARGET_URL=
ALLOW_PRODUCTION_TARGET_IN_TEST_MODE=false
TEST_MODE_DISABLE_COMMENT=true
# Phase 6 additions
TEST_MODE_POST_PREFIX=[TEST WORKFLOW — NOT FOR CLINICAL USE]
TEST_MODE_REQUIRE_SYNTHETIC_CASE=true

# ============================================================
# Legacy AutoFacebook-SonMinhShare configuration
# (kept for compatibility with existing tools)
# ============================================================
MODE=JOIN_BY_LIST
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_DOMAIN=y tế
DEDUP_API_BASE=https://upload.cdha.ai/api/autopost.php
DEDUP_API_KEY=
